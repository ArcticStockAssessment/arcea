create_data <- function(var, val){
assign(var, val)
do.call(usethis::use_data,
list(as.name(var),
overwrite = TRUE))
}
create_data(paste0("greenland_halibut_biomass_", assess_yr),
get(paste0("greenland_halibut_biomass_", assess_yr)))
